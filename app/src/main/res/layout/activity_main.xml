<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Private browsing indicator banner -->
    <LinearLayout
        android:id="@+id/privateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_private_banner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/private_badge"
            app:srcCompat="@drawable/ic_shield_private"
            app:tint="@color/text_on_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/private_browsing_banner"
            android:textColor="@color/text_on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- TV Mode Top Host (holds toolbarView on Android TV; hidden on Phone) -->
    <LinearLayout
        android:id="@+id/tvTopHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Chrome iOS Omnibox Bar (placed at top in TV mode, moved to bottom dock in Phone mode) -->
        <LinearLayout
            android:id="@+id/toolbarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp">

            <!-- TV Mode Top Navigation Cluster -->
            <LinearLayout
                android:id="@+id/tvNavCluster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tvNavBackButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tv_focus"
                    android:contentDescription="@string/nav_back"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_ios_back"
                    app:tint="@color/nav_icon_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tvNavForwardButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tv_focus"
                    android:contentDescription="@string/nav_forward"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_ios_forward"
                    app:tint="@color/nav_icon_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tvNavHomeButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tv_focus"
                    android:contentDescription="@string/nav_home"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_home"
                    app:tint="@color/nav_icon_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/omniboxContainer"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                tools:targetApi="lollipop">

                <!-- Security Lock & Tracker Counter Pill -->
                <LinearLayout
                    android:id="@+id/securityShieldPill"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_shield_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="42dp"
                    android:orientation="horizontal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/trackerCountViewImage"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/security_info_title"
                        app:srcCompat="@drawable/ic_lock_secure"
                        app:tint="@color/accent_secure" />

                    <TextView
                        android:id="@+id/trackerCountView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:text="@string/_0"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/urlEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:hint="@string/location_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:paddingLeft="8dp"
                    android:paddingRight="4dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/clearUrlButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_url"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/text_secondary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/voiceSearchButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_search"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_mic"
                    app:tint="@color/accent_blue" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/bookmarkButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/bookmark_toggle"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_star_outline"
                    app:tint="@color/text_secondary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/shareUrlButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_share"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_ios_share"
                    app:tint="@color/nav_icon_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/reloadStopButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reload_page"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_refresh"
                    app:tint="@color/nav_icon_tint" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tvNavTabsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_tv_focus"
                android:clickable="true"
                android:contentDescription="@string/nav_tabs"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTabsCountView"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_badge"
                    android:gravity="center"
                    android:text="@string/_0"
                    android:textColor="@color/nav_icon_tint"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tvNavMoreButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_focus"
                android:contentDescription="@string/nav_more"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_more_horiz"
                app:tint="@color/nav_icon_tint" />
        </LinearLayout>
    </LinearLayout>

    <!-- Find in Page Bar -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/menu_find_in_page"
            app:srcCompat="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/findEditText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/findMatchCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findPrevButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_prev"
            android:padding="9dp"
            app:srcCompat="@drawable/ic_keyboard_arrow_up"
            app:tint="@color/accent_blue" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findNextButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_next"
            android:padding="9dp"
            app:srcCompat="@drawable/ic_keyboard_arrow_down"
            app:tint="@color/accent_blue" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findCloseButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_close"
            android:padding="9dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Thin Chrome iOS Blue Progress Bar -->
    <ProgressBar
        android:id="@+id/pageProgressView"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_chrome_ios"
        android:visibility="gone" />

    <!-- GeckoView Viewport + Fullscreen Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:saveEnabled="false"
            android:visibility="visible"
            tools:context=".MainActivity" />

        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <!-- Chrome on iPhone (iOS 27 Liquid Glass) New Tab / Start Page -->
        <LinearLayout
            android:id="@+id/startPageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Chrome iPhone NTP Top Action Header -->
            <LinearLayout
                android:id="@+id/startPageTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/startPageIncognitoPill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ios_squircle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/startPageIncognitoPillIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/new_private_tab"
                        app:srcCompat="@drawable/ic_shield_private"
                        app:tint="@color/accent_private" />

                    <TextView
                        android:id="@+id/startPageIncognitoPillText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginLeft="6dp"
                        android:text="@string/private_badge"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/startPageSettingsBtn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ios_squircle"
                    android:contentDescription="@string/menu_settings"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_settings"
                    app:tint="@color/nav_icon_tint" />
            </LinearLayout>

            <!-- Hero Brand / Incognito Emblem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/startPageHeroLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/ic_chrome_ring" />

                <TextView
                    android:id="@+id/startPageHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/startPageHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/start_page_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Large Chrome iOS Search Pill -->
            <LinearLayout
                android:id="@+id/startPageSearchCard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_ios_omnibox_ntp"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="10dp"
                tools:targetApi="lollipop">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/startPageSearchIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/location_hint"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/startPageSearchHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:text="@string/location_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/startPageVoiceBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_search"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_mic"
                    app:tint="@color/accent_blue" />
            </LinearLayout>

            <!-- Chrome iOS Quick Action Squircles -->
            <LinearLayout
                android:id="@+id/startPageQuickActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/startPageBookmarksBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:id="@+id/startPageBookmarksBg"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_ios_squircle">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/menu_bookmarks"
                            app:srcCompat="@drawable/ic_star_filled"
                            app:tint="@color/accent_blue" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/startPageBookmarksLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/menu_bookmarks"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/startPageHistoryBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:id="@+id/startPageHistoryBg"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_ios_squircle">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/menu_history"
                            app:srcCompat="@drawable/ic_history"
                            app:tint="@color/accent_blue" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/startPageHistoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/menu_history"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/startPageDownloadsBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:id="@+id/startPageDownloadsBg"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_ios_squircle">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/menu_downloads"
                            app:srcCompat="@drawable/ic_download"
                            app:tint="@color/accent_blue" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/startPageDownloadsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/menu_downloads"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/startPageIncognitoBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:id="@+id/startPageIncognitoBg"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_ios_squircle">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/new_private_tab"
                            app:srcCompat="@drawable/ic_shield_private"
                            app:tint="@color/accent_private" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/startPageIncognitoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/private_badge"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/startPageQuickAccessTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/quick_access_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/startPageAddShortcutBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_quick_site"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="@color/accent_blue" />
            </LinearLayout>

            <GridView
                android:id="@+id/startPageGridView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnWidth="76dp"
                android:horizontalSpacing="10dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="12dp" />
        </LinearLayout>

        <!-- Omnibox Autocomplete & Quick Access Overlay -->
        <LinearLayout
            android:id="@+id/suggestionsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:visibility="gone">

            <ListView
                android:id="@+id/suggestionsListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Phone Mode Chrome iOS Bottom Dock (holds bottom Omnibox + Liquid Glass Nav Pill) -->
    <LinearLayout
        android:id="@+id/phoneBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- iOS 27 Floating Liquid Glass 5-Button Capsule -->
        <LinearLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/bottomNavPill"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_ios_glass_bar"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                tools:targetApi="lollipop">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/navBackButton"
                    style="@style/BrowserActionButton"
                    android:contentDescription="@string/nav_back"
                    app:srcCompat="@drawable/ic_ios_back"
                    app:tint="@color/nav_icon_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/navForwardButton"
                    style="@style/BrowserActionButton"
                    android:contentDescription="@string/nav_forward"
                    app:srcCompat="@drawable/ic_ios_forward"
                    app:tint="@color/nav_icon_tint" />

                <!-- Chrome iOS Signature Center '+' New Tab Button -->
                <FrameLayout
                    android:id="@+id/navHomeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/menu_new_tab"
                    android:focusable="true"
                    android:minWidth="48dp"
                    android:minHeight="48dp">

                    <FrameLayout
                        android:id="@+id/navPlusPillBg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shield_pill">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/navHomePlusIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/menu_new_tab"
                            app:srcCompat="@drawable/ic_add"
                            app:tint="@color/nav_icon_tint" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/navTabsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/nav_tabs"
                    android:focusable="true"
                    android:minWidth="48dp"
                    android:minHeight="48dp">

                    <TextView
                        android:id="@+id/tabsCountView"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tab_badge"
                        android:gravity="center"
                        android:text="@string/_0"
                        android:textColor="@color/nav_icon_tint"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/navMoreButton"
                    style="@style/BrowserActionButton"
                    android:contentDescription="@string/nav_more"
                    app:srcCompat="@drawable/ic_more_horiz"
                    app:tint="@color/nav_icon_tint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
