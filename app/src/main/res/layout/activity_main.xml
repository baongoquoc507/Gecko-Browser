<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Private browsing indicator banner -->
    <LinearLayout
        android:id="@+id/privateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_private_banner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/private_badge"
            app:srcCompat="@drawable/ic_shield_private"
            app:tint="@color/text_on_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/private_browsing_banner"
            android:textColor="@color/text_on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Modern Top Omnibox Bar -->
    <LinearLayout
        android:id="@+id/toolbarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="6dp">

        <!-- TV Mode Top Navigation Cluster -->
        <LinearLayout
            android:id="@+id/tvNavCluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tvNavBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_focus"
                android:contentDescription="@string/nav_back"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/nav_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tvNavForwardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_focus"
                android:contentDescription="@string/nav_forward"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_arrow_forward"
                app:tint="@color/nav_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tvNavHomeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_focus"
                android:contentDescription="@string/nav_home"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/nav_icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/omniboxContainer"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_omnibox"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="4dp">

            <!-- Security Lock & Tracker Counter Pill -->
            <LinearLayout
                android:id="@+id/securityShieldPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_shield_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/trackerCountViewImage"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@string/security_info_title"
                    app:srcCompat="@drawable/ic_lock_secure"
                    app:tint="@color/accent_secure" />

                <TextView
                    android:id="@+id/trackerCountView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:text="@string/_0"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/location_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:paddingLeft="8dp"
                android:paddingRight="4dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/clearUrlButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_url"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/voiceSearchButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_search"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_mic"
                app:tint="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/bookmarkButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bookmark_toggle"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_star_outline"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/reloadStopButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginLeft="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reload_page"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_refresh"
            app:tint="@color/nav_icon_tint" />

        <FrameLayout
            android:id="@+id/tvNavTabsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_tv_focus"
            android:clickable="true"
            android:contentDescription="@string/nav_tabs"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTabsCountView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_badge"
                android:gravity="center"
                android:text="@string/_0"
                android:textColor="@color/nav_icon_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/tvNavMoreButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tv_focus"
            android:contentDescription="@string/nav_more"
            android:focusable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_more_vert"
            app:tint="@color/nav_icon_tint" />
    </LinearLayout>

    <!-- Find in Page Bar -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/menu_find_in_page"
            app:srcCompat="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/findEditText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/findMatchCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findPrevButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_prev"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_keyboard_arrow_up"
            app:tint="@color/nav_icon_tint" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findNextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_next"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_keyboard_arrow_down"
            app:tint="@color/nav_icon_tint" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/find_close"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/nav_icon_tint" />
    </LinearLayout>

    <!-- Thin Modern Progress Bar -->
    <ProgressBar
        android:id="@+id/pageProgressView"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <!-- Subtle top hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- GeckoView Viewport + Fullscreen Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:saveEnabled="false"
            android:visibility="visible"
            tools:context=".MainActivity" />

        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <!-- Built-in Start Page / Speed Dial -->
        <LinearLayout
            android:id="@+id/startPageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher_round" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/start_page_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/startPageSearchCard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_omnibox"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/location_hint"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="@string/location_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quick_access_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/startPageAddShortcutBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_quick_site"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="@color/accent_blue" />
            </LinearLayout>

            <GridView
                android:id="@+id/startPageGridView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnWidth="96dp"
                android:horizontalSpacing="10dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />
        </LinearLayout>

        <!-- Omnibox Autocomplete & Quick Access Overlay -->
        <LinearLayout
            android:id="@+id/suggestionsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:orientation="vertical"
            android:visibility="gone">

            <ListView
                android:id="@+id/suggestionsListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Navigation Chrome -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/navBackButton"
                style="@style/BrowserActionButton"
                android:contentDescription="@string/nav_back"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/nav_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/navForwardButton"
                style="@style/BrowserActionButton"
                android:contentDescription="@string/nav_forward"
                app:srcCompat="@drawable/ic_arrow_forward"
                app:tint="@color/nav_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/navHomeButton"
                style="@style/BrowserActionButton"
                android:contentDescription="@string/nav_home"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/nav_icon_tint" />

            <FrameLayout
                android:id="@+id/navTabsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/nav_tabs"
                android:focusable="true"
                android:minWidth="48dp"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/tabsCountView"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_badge"
                    android:gravity="center"
                    android:text="@string/_0"
                    android:textColor="@color/nav_icon_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/navMoreButton"
                style="@style/BrowserActionButton"
                android:contentDescription="@string/nav_more"
                app:srcCompat="@drawable/ic_more_vert"
                app:tint="@color/nav_icon_tint" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>