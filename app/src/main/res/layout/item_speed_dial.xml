<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="86dp"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/speedDialIconBg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_ios_squircle"
        android:elevation="2dp"
        tools:targetApi="lollipop">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/speedDialIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/quick_access_title"
            app:srcCompat="@drawable/ic_public"
            app:tint="@color/accent_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/speedDialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="normal" />
</LinearLayout>
