<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_modern"
    android:gravity="center"
    android:minHeight="88dp"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_shield_pill">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/speedDialIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/quick_access_title"
            app:srcCompat="@drawable/ic_public"
            app:tint="@color/accent_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/speedDialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
